# Copy this to backend/.env and fill in NEO4J_PASSWORD.
# .env is gitignored - never commit the real one.
#
# These are only needed for the manual (non-Docker) dev setup. Under Docker,
# docker-compose.yml supplies them instead.

MONGO_URI=mongodb://localhost:27017
MONGO_DB=omniguard

NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# who may call the API from a browser, comma-separated. Defaults to the Vite
# dev server if unset.
CORS_ORIGINS=http://localhost:5173

# Machine clients (e.g. the MCP server) sign in with a service token instead of
# a password. Comma-separated; give each client its own and set the same value
# as OMNIGUARD_API_TOKEN in that client's environment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SERVICE_TOKENS=

# Optional shared keys for the containment/DFIR endpoint agent (open by default for LAN demos)
# CONTAINMENT_AGENT_KEYS=

# Optional phone push notifications (ntfy, Telegram, or Discord/Slack webhook)
# NOTIFY_MIN_SEVERITY=high
# DASHBOARD_PUBLIC_URL=http://localhost:5173
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=

# Optional 3rd-party EDR / Threat Intel connectors
# ACTION1_CLIENT_ID=
# ACTION1_CLIENT_SECRET=
# CROWDSTRIKE_CLIENT_ID=
# CROWDSTRIKE_CLIENT_SECRET=
# PALOALTO_HOST=
# PALOALTO_API_KEY=
# ABUSEIPDB_API_KEY=
# VIRUSTOTAL_API_KEY=
