# Copy this to backend/.env and fill in NEO4J_PASSWORD.
# .env is gitignored - never commit the real one.
#
# These are only needed for the manual (non-Docker) dev setup. Under Docker,
# docker-compose.yml supplies them instead.

MONGO_URI=mongodb://localhost:27017
MONGO_DB=omniguard

NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# who may call the API from a browser, comma-separated. Defaults to the Vite
# dev server if unset.
CORS_ORIGINS=http://localhost:5173
