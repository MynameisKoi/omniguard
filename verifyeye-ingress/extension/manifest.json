{
    "manifest_version": 3,
    "name": "VerifyEye",
    "version": "0.1.0",
    "description": "Real-time phising login detection and interception",
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "css": ["overlay.css"],
            "run_at": "document_idle"
        }
    ],
    "background": {"service_worker": "background.js"},
    "host_permissions": ["<all_urls>"],
    "permissions": ["storage", "declarativeNetRequest"]
}